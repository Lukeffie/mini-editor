{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniEditor",
  "version": "1.0.0",
  "identifier": "com.mini.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "极简编辑器",
        "width": 1100,
        "height": 720,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob: asset:; img-src * data: blob: asset:; media-src * data: blob: asset:; frame-src *; style-src * 'unsafe-inline'; font-src * data:; script-src * 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "language": ["en-US"],
        "template": "wix/main.wxs"
      }
    },
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown 文档", "role": "Editor" },
      { "ext": ["txt"], "name": "文本文档", "role": "Editor" },
      { "ext": ["html", "htm"], "name": "HTML 文档", "role": "Editor" },
      { "ext": ["json", "xml"], "name": "数据文档", "role": "Editor" }
    ]
  }
}
